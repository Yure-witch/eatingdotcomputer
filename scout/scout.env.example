# Copy to scout.env and fill in. SCOUT_TOKEN must match the app's env var.
EATING_URL=https://eating.computer
SCOUT_TOKEN=paste-the-token-here
POLL_MS=30000
EUROPEANA_KEY=api2demo
HARVARD_KEY=

# Page rendering for Lab → Inspiration screenshots (optional — without
# CHROME_BIN the worker skips `shot` jobs and everything else still runs).
# Installed on kahan without root: `apt-get download` + `dpkg -x` for the
# graphics libs, plus Chrome-for-Testing's headless shell.
CHROME_BIN=/zooper2/richard.yurewitch/chrome/bin/chrome-headless-shell-linux64/chrome-headless-shell
CHROME_LIBS=/zooper2/richard.yurewitch/chrome/root/usr/lib/x86_64-linux-gnu
# kahan's AFS home is unreadable; Chromium needs a writable HOME.
CHROME_HOME=/zooper2/richard.yurewitch
SHOT_W=1280
SHOT_H=800
SHOT_TIMEOUT_MS=45000
