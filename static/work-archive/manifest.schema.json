{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.eating.computer/work-archive/manifest.schema.json",
  "title": "eating.computer Work Archive manifest",
  "description": "Protocol eating.computer/work-archive@1. Human/agent guide: https://www.eating.computer/work-archive/PROTOCOL.md. Extra fields are allowed and kept.",
  "type": "object",
  "required": ["schema", "student", "consent", "projects"],
  "properties": {
    "schema": { "const": "eating.computer/work-archive@1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "properties": { "agent": { "type": "string" }, "model": { "type": "string" }, "notes": { "type": "string" } }
    },
    "student": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "preferred_name": { "type": "string" },
        "pronouns": { "type": "string" },
        "program": { "type": "string" },
        "year": { "type": "string" },
        "background": { "type": "string" },
        "prior_experience": {
          "type": "object",
          "properties": { "coding": { "type": "string" }, "design": { "type": "string" }, "ai_tools": { "type": "string" } }
        },
        "goals_for_class": { "type": "string" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },
    "consent": {
      "type": "object",
      "required": ["archive_for_instructor", "use_in_funding_reports", "use_in_public_showcase", "quote_permission", "attribution", "confirmed_by_student_at"],
      "properties": {
        "archive_for_instructor": { "const": true },
        "use_in_funding_reports": { "type": "boolean" },
        "use_in_public_showcase": { "type": "boolean" },
        "quote_permission": { "type": "boolean" },
        "attribution": { "enum": ["full_name", "first_name", "initials", "anonymous"] },
        "notes": { "type": "string" },
        "confirmed_by_student_at": { "type": "string", "format": "date-time" }
      }
    },
    "overview": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "themes": { "type": "array", "items": { "type": "string" } },
        "growth_narrative": { "type": "string" },
        "proudest_project": { "type": "string" },
        "stats": { "type": "object" }
      }
    },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "ideas": { "type": "array", "items": { "$ref": "#/$defs/idea" } },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" }, "before": { "type": "string" }, "after": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "category": { "enum": ["llm", "code", "image", "video", "audio", "design", "other"] },
          "used_for": { "type": "string" },
          "projects": { "type": "array", "items": { "type": "string" } },
          "frequency": { "type": "string" },
          "opinion": { "type": "string" }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": { "type": "object", "properties": { "date": { "type": "string" }, "event": { "type": "string" }, "project": { "type": ["string", "null"] } } }
    },
    "reflections": {
      "type": "object",
      "properties": {
        "on_ai": { "type": "string" }, "on_class": { "type": "string" }, "process_change": { "type": "string" },
        "advice_to_future_students": { "type": "string" }, "what_next": { "type": "string" }
      }
    },
    "testimonial": { "type": "string" },
    "sources_searched": { "type": "array", "items": { "type": "string" } },
    "omissions": {
      "type": "array",
      "items": { "type": "object", "properties": { "what": { "type": "string" }, "reason": { "type": "string" } } }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "description": "Relative path inside the archive (e.g. images/my-project/01-hero.png). Letters, digits, . _ - and / only.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,5}$",
      "maxLength": 200
    },
    "link": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string" },
        "kind": { "enum": ["live", "repo", "video", "figma", "doc", "other"] }
      }
    },
    "asset": {
      "oneOf": [
        { "$ref": "#/$defs/path" },
        {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "kind": { "enum": ["final", "screenshot", "process", "sketch", "diagram", "photo", "generated", "recording", "document"] },
            "caption": { "type": "string" },
            "alt": { "type": "string" },
            "date": { "type": "string" },
            "credit": { "enum": ["student", "ai", "mixed", "other"] }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "title": { "type": "string", "minLength": 1 },
        "one_liner": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "status": { "enum": ["idea", "prototype", "in_progress", "shipped", "paused", "abandoned"] },
        "kind": { "type": "array", "items": { "type": "string" } },
        "course_connection": {
          "type": "object",
          "properties": { "assignment": { "type": ["string", "null"] }, "week": { "type": ["integer", "null"] }, "self_initiated": { "type": "boolean" } }
        },
        "dates": {
          "type": "object",
          "properties": { "started": { "type": ["string", "null"] }, "last_worked": { "type": ["string", "null"] }, "completed": { "type": ["string", "null"] } }
        },
        "time_spent_hours": { "type": ["number", "null"] },
        "time_spent_basis": { "type": "string" },
        "collaborators": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "role": { "type": "string" } } } },
        "ai_usage": {
          "type": "object",
          "properties": {
            "tools": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "model": { "type": "string" }, "used_for": { "type": "string" } } }
                ]
              }
            },
            "role_of_ai": { "type": "string" },
            "role_of_student": { "type": "string" },
            "share_ai_generated": { "enum": ["none", "some", "half", "most", "all"] },
            "key_prompts": {
              "type": "array",
              "items": { "type": "object", "properties": { "prompt": { "type": "string" }, "outcome": { "type": "string" }, "date": { "type": "string" } } }
            },
            "what_worked": { "type": "string" },
            "what_didnt": { "type": "string" },
            "surprises": { "type": "string" }
          }
        },
        "process": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" },
              "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
            }
          }
        },
        "technical": { "type": "object" },
        "outcomes": { "type": "object" },
        "learning": {
          "type": "object",
          "properties": {
            "skills_gained": { "type": "array", "items": { "type": "string" } },
            "concepts": { "type": "array", "items": { "type": "string" } },
            "challenges": { "type": "array", "items": { "type": "string" } },
            "reflection": { "type": "string" }
          }
        },
        "quotes": {
          "type": "array",
          "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "context": { "type": "string" }, "source": { "enum": ["student", "transcript"] } } }
        },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "hero_asset": { "$ref": "#/$defs/path" },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "provenance": {
          "type": "object",
          "properties": {
            "sources": { "type": "array", "items": { "type": "string" } },
            "confidence": { "enum": ["high", "medium", "low"] },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "idea": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "origin": { "type": "string" },
        "date": { "type": "string" },
        "status": { "enum": ["raw", "explored", "parked", "became_project", "abandoned"] },
        "related_project": { "type": ["string", "null"] },
        "why_not_pursued": { "type": "string" },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
