{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "lastRead": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "unreadCounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "typing": {
      "$convId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "convReads": {
      "$convId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "channels": {
      "$channelId": {
        "messages": {
          ".read": "auth != null"
        },
        "reactions": {
          ".read": "auth != null"
        },
        "lastAt": {
          ".read": "auth != null"
        }
      }
    },
    "dms": {
      "$convId": {
        "messages": {
          ".read": "auth != null"
        },
        "reactions": {
          ".read": "auth != null"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "notifReadAt": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber()"
      }
    },
    "channelMeta": {
      ".read": "auth != null"
    },
    "pendingRequests": {
      ".read": "auth != null"
    },
    "approvals": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "false"
      }
    },
    "threads": {
      "$convId": {
        ".read": "auth != null"
      }
    },
    "attendanceNotes": {
      ".read": "auth != null && auth.token.role === 'instructor'",
      ".write": "auth != null && auth.token.role === 'instructor'",
      "$classId": {
        "$date": {
          "$uid": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['updatedAt'])",
            "workingOn": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 4000" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "updatedBy": { ".validate": "newData.val() === auth.uid" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "themes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "threadReads": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "dev": {
      ".read": "auth != null",
      "refreshNeeded": {
        ".write": "false"
      }
    },
    "marquee": {
      "$room": {
        ".read": true,
        "host": {
          ".write": "auth != null"
        },
        "now": {
          ".write": "auth != null"
        },
        "idle": {
          ".write": "auth != null"
        },
        "queue": {
          ".write": "auth != null",
          "$item": {
            ".validate": "newData.hasChildren(['text','holdMs','at'])"
          }
        }
      }
    },
    "pollLive": {
      "$pollId": {
        ".read": "auth != null",
        ".write": "false"
      }
    },
    "pollRoom": {
      "$shareCode": {
        ".read": true,
        ".write": false
      }
    },
    "scout": {
      "wake": {
        ".read": true,
        ".write": false
      }
    },
    "bt": {
      "$room": {
        ".read": true,
        ".write": "$room.matches(/^[0-9a-f]{32}$/)",
        ".validate": "newData.hasChildren(['k','solved','at'])",
        "k": { ".validate": "newData.isNumber()" },
        "solved": { ".validate": "newData.isNumber()" },
        "at": { ".validate": "newData.isNumber()" },
        "frames": { ".validate": "newData.isNumber()" },
        "state": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "missing": { ".validate": "newData.isString() && newData.val().length <= 8000" },
        "$other": { ".validate": false }
      }
    }
  }
}
