.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Telegram emoji puller — session file = live account access; never commit
*.session
*.session-journal
/telegram_official_emoji/
/telegram_custom_packs/
/examples/telegram_official_emoji/

# Generated by the emoji thumb pipeline (examples/render_thumbs.mjs +
# pack_sprite_sheet.mjs). Re-runnable locally; upload to R2 directly.
/thumbs_out/
/sprite_out/

# Local design reference (~300 MB Flutter build). Used to study the
# Material 3 TemperatureCache complement algorithm — see
# src/lib/theme-store.js.
/examples/monet-gallery/

# Raw Emoji Kitchen source dump from Google (~245 MB textproto with
# all ~140k combos). Too big to commit; a slimmer JSON derivative
# (just emoji-pair → URL) is what gets shipped to the client.
/emoji_kitchen_v6.textproto
*.textproto

# Capacitor native iOS — generated CocoaPods + Xcode build artifacts. The
# ios/ project itself can be committed or regenerated via `npx cap add ios`;
# these heavy/per-machine bits never should be.
/ios/App/Pods/
/ios/App/Podfile.lock
/ios/App/output/
/ios/DerivedData/
/ios/capacitor-cordova-ios-plugins/
**/xcuserdata/

# Stray Web Inspector timeline recordings
*recording*.json

# Account backups — contain real user messages/sessions, never commit
artifacts/backups/

# scratch verification scripts
_verify.mjs
_m.mjs
_v.mjs
_dbg.mjs
firebase-debug.log
